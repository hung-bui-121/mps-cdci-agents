# Cấu hình cho skill mps-git-flow (Claude Code).
# - File này nằm ở thư mục gốc project và KHÔNG được commit (skill tự thêm .env vào .gitignore).
# - Tự mở file bằng trình soạn thảo (Notepad, VS Code...) để điền token. KHÔNG dán token vào khung chat.
# - Giá trị trong file này là nguồn duy nhất: biến môi trường của hệ điều hành KHÔNG được dùng.
# - Mỗi dòng dạng KHOA=gia_tri. Dòng bắt đầu bằng # là ghi chú.

# ---------------- Jira ----------------
MPS_JIRA_URL=https://jira-mps.mto.zing.vn
# Personal Access Token của Jira:
#   Jira > bấm ảnh đại diện (góc phải) > Profile > Personal Access Tokens > Create token
MPS_JIRA_PAT=
# Mã project Jira (board) mặc định khi TẠO ticket mới (ví dụ: MPS). Bắt buộc. Để trống thì trợ lý sẽ đưa danh
# sách để bạn chọn rồi tự điền. Có thể khác tên project GitLab (ví dụ team artist dùng board ART). Ticket có sẵn
# ở board nào cũng dùng được; muốn tạo một ticket lẻ ở board khác thì trợ lý sẽ hỏi, không cần sửa dòng này.
MPS_JIRA_PROJECT_KEY=

# ---------------- GitLab ----------------
MPS_GITLAB_URL=https://git-gst.mto.zing.vn
# Personal Access Token của GitLab:
#   GitLab > ảnh đại diện > Edit profile (User Settings) > Access Tokens
#   Chọn scope: api, write_repository. Đặt ngày hết hạn theo quy định của team.
MPS_GITLAB_PAT=
# Đường dẫn project dạng group/project. Để trống thì tự lấy từ "git remote origin".
MPS_GITLAB_PROJECT=

# ---------------- Tên nhánh (thường không cần sửa) ----------------
MPS_BRANCH_DEV=develop
MPS_BRANCH_BETA_PREFIX=release/
MPS_BRANCH_PROD=master

# ---------------- Tuỳ chọn ----------------
# Đường dẫn file chứng chỉ CA nội bộ (nếu gặp lỗi SSL). Có thể là đường dẫn tương đối so với thư mục project.
MPS_CA_BUNDLE=
# Thêm mẫu file do công cụ tự sinh/tự sửa (cách nhau bằng dấu phẩy, ví dụ: Assets/Gen/**,*.lock). Các file này
# không làm thay đổi việc chọn giai đoạn (dev/beta/production); chúng vẫn được review và KHÔNG tự động commit.
# Mặc định đã có: ProjectSettings/**, Packages/packages-lock.json, UserSettings/**, *.csproj, *.sln, Library/**
MPS_GENERATED_PATTERNS=
